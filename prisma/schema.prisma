// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  profile   Profile?
  teeTimes  TeeTime[]
  sent      Message[]   @relation("MessageSender")
  received  Message[]   @relation("MessageRecipient")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  phone                    String?
  phoneVerifiedAt          DateTime?
  phoneVerificationCode    String?
  phoneVerificationExpires DateTime?
  city                     String?
  state                    String?
  latitude                 Float?
  longitude                Float?
  golfersNeeded            Int       @default(1)
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeeTime {
  id                  String   @id @default(cuid())
  courseName          String
  courseCity          String
  courseState         String
  latitude            Float?
  longitude           Float?
  teeTime             DateTime
  coursePricePerSlot  Int      // What you pay at the golf course
  sellerPricePerSlot  Int      // What buyer pays the seller for the slot
  slotsTotal          Int
  slotsTaken          Int      @default(0)
  sellerId            String
  contactPreference   String   @default("website") // "email" | "phone" | "website"
  createdAt           DateTime @default(now())

  seller   User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  recipientId String
  teeTimeId  String
  body       String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender    User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  teeTime   TeeTime  @relation(fields: [teeTimeId], references: [id], onDelete: Cascade)
}
