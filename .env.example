# Database (PostgreSQL)
# Local: run `npx prisma dev` for local Postgres, or use Neon/Supabase connection string
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth (required)
# Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-key"

# Production only - your deployed URL
# NEXTAUTH_URL="https://your-domain.vercel.app"

# Optional: Email (Resend) – verification + seller notifications
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="notifications@yourdomain.com"

# Optional: SMS verification (Twilio)
# TWILIO_ACCOUNT_SID="..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+1234567890"